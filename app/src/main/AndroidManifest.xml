<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Red: cargar Odoo y saber si hay conexión (para elegir el modo de caché). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Cámara: tomar fotos para adjuntar y escáner de códigos de barras web de Odoo (getUserMedia).
         Al declararla, ACTION_IMAGE_CAPTURE exige que el permiso esté concedido en runtime. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Solo Android 9 o inferior: escribir en /Download. En 10+ se usa MediaStore sin permiso. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Visibilidad de paquetes (Android 11+): necesaria para resolveActivity() de la cámara
         y para abrir el PDF descargado con otra app. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!-- allowBackup=false: evita que las cookies de sesión de Odoo se restauren en otro dispositivo. -->
    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OdooClient">

        <!-- configChanges: rotar o desplegar un plegable NO recrea la Activity, así Odoo (SPA)
             no se recarga completo y no se pierde el formulario que el usuario estaba editando. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Accesos directos (long-press en el ícono): "Servidores" + uno por empresa. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- exported=true para que el launcher pueda abrirlo desde el acceso directo "Servidores". -->
        <activity
            android:name=".ServerPickerActivity"
            android:exported="true" />

        <!-- FileProvider: URI segura para la foto de la cámara y para abrir descargas en Android ≤ 9. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
